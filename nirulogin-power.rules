// NIRULOGIN: let the local, active greeter session power off or restart a
// machine nobody else is using. The *-multiple-sessions actions (other users
// logged in, for example over SSH) are deliberately not granted here, so they
// keep the system's default policy (administrator authentication).
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active) {
        return;
    }
    if (subject.user != "_greetd" &&
        subject.user != "greeter" &&
        subject.user != "_greeter") {
        return;
    }
    var allowed = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.reboot"
    ];
    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
